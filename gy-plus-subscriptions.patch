r": "अपने बारे में एक पंक्ति (160 अक्षर)", "profile.save": "प्रोफ़ाइल सहेजें", "profile.scores": "सर्वश्रेष्ठ स्कोर", "profile.badges": "बैज", "profile.saved": "प्रोफ़ाइल सहेजी गई", "profile.joined": "{date} को जुड़े", "profile.noScores": "अभी कोई स्कोर नहीं। स्कोर बनाने के लिए किसी गेम के अंदर लॉग इन करें।", "news.title": "समाचार", "news.sub": "स्टूडियो की ताज़ा खबरें", "badge.welcome": "स्वागत है", "badge.welcome.desc": "आपने GY खाता बनाया", "badge.first_favorite": "पहला पसंदीदा", "badge.first_favorite.desc": "आपने एक गेम पसंदीदा में सहेजा", "badge.first_score": "बोर्ड पर", "badge.first_score.desc": "आपने अपना पहला स्कोर बनाया", "badge.all_rounder": "ऑल-राउंडर", "badge.all_rounder.desc": "3 अलग-अलग गेम में स्कोर किया", "badge.veteran": "अनुभवी", "badge.veteran.desc": "30 से ज़्यादा दिनों से खिलाड़ी", "badge.top3": "{game} में टॉप 3", "badge.top3.desc": "आप लीडरबोर्ड के टॉप 3 में पहुँचे", "badge.top3.locked": "टॉप 3", "games.cat.puzzle": "पहेली"}, "ta": {"brand.tagline": "சிமுலேஷன் மற்றும் விளையாட்டுகள்", "nav.home": "முகப்பு", "nav.about": "எங்களைப் பற்றி", "nav.contact": "தொடர்பு", "nav.exploreGames": "விளையாட்டுகளை காணுங்கள்", "home.eyebrow": "<b>இரண்டு சகோதரர்கள்</b> &middot; அக்டோபர் 2025 இல் தொடங்கப்பட்டது", "home.headline": "சிறிய ஸ்டூடியோ.<br><em>நேர்மையான</em> விளையாட்டுகள்.", "home.lead": "GY Industries சிமுலேஷன்களையும் விளையாட்டுகளையும் தொடக்கத்திலிருந்தே உருவாக்குகிறது — டெம்ப்ளேட் இல்லை, ஷார்ட்கட் இல்லை. அனைத்தும் உங்கள் பிரவுசரில் நேரடியாக விளையாடக்கூடியது.", "home.cta.explore": "விளையாட்டுகளை காணுங்கள் →", "common.contactUs": "தொடர்பு கொள்ளுங்கள்", "diff.eyebrow": "GY Industries இன் தனித்தன்மை", "diff.heading": "நோக்கத்துடன் உருவாக்கப்பட்டது, விளையாட வடிவமைக்கப்பட்டது", "diff.item1.title": "எப்போதும் எங்களால் உருவாக்கப்பட்டது", "diff.item1.body": "ஒவ்வொரு விளையாட்டும் இரண்டு சகோதரர்களால் நேரடியாக வடிவமைக்கப்பட்டு குறியீடு செய்யப்படுகிறது — டெம்ப்ளேட் இல்லை, ஷார்ட்கட் இல்லை, அவுட்சோர்சிங் இல்லை.", "diff.item2.title": "உடனடியாக விளையாடக்கூடியது", "diff.item2.body": "பதிவிறக்கம் இல்லை, நிறுவல் இல்லை, காத்திருப்பு இல்லை. ஒரு இணைப்பைக் கிளிக் செய்தால் நேரடியாக விளையாட்டுக்குள் நுழையலாம்.", "diff.item3.title": "ஒரு சிறிய ஸ்டூடியோ", "diff.item3.body": "நாங்களே எல்லாவற்றையும் உருவாக்குகிறோம், சோதிக்கிறோம், வெளியிடுகிறோம் — இது இன்னும் ஆரம்பம் தான்.", "games.eyebrow": "எங்கள் விளையாட்டுகள்", "games.heading": "இதுவரை நாங்கள் உருவாக்கியவை", "games.cat.simulation": "சிமுலேஷன்", "games.cat.collection": "தொகுப்பு", "games.cat.arcade": "ஆர்கேட்", "games.cat.strategy": "உத்தி", "cta.heading": "ஒரு யோசனை உள்ளதா?<br>எந்த விளையாட்டும். எந்த பயன்முறையும். விளையாட உங்களுக்காக.", "cta.browseGames": "விளையாட்டுகளைப் பார்க்க", "about.eyebrow": "எங்களைப் பற்றி", "about.headline": "இரண்டு சகோதரர்கள்,<br>ஒரே <em>ஸ்டூடியோ</em>.", "about.lead": "GY Industries இன் கதை.", "role.founder": "நிறுவனர்", "role.cofounder": "இணை நிறுவனர்", "role.cmSales": "தலைமை மார்க்கெட்டிங் & விற்பனை அதிகாரி", "role.designer": "வடிவமைப்பாளர்", "role.cfo": "தலைமை நிதி அதிகாரி", "role.marketing": "மார்க்கெட்டிங்", "role.illustrator": "சித்திரக் கலைஞர்", "about.storyPanel": "GY Industries <em>அக்டோபர் 2025</em> இல் ஒரு எளிய யோசனையுடன் தொடங்கியது: நாங்கள் எப்போதும் இருக்க வேண்டும் என விரும்பிய விளையாட்டுகளை உருவாக்குவது.", "common.estOct2025": "அக்டோபர் 2025 இல் தொடங்கப்பட்டது", "team.eyebrow": "குழு", "team.heading": "இதை சாத்தியமாக்கும் நபர்கள்", "contact.headline": "எங்களிடம் <em>வணக்கம்</em> சொல்லுங்கள்.", "contact.lead": "கேள்விகள், யோசனைகள், அல்லது கருங்கொட்டைகள் பற்றி பேச விரும்புகிறீர்களா?", "contact.studioInfo": "ஸ்டூடியோ தகவல்", "footer.description": "இரண்டு சகோதரர்களான கிரிஷ் பிஞ்சா மற்றும் யவ்யா பிஞ்சாவால் உருவாக்கப்பட்ட சிமுலேஷன்களும் விளையாட்டுகளும். சிறிய ஸ்டூடியோ, பெரிய யோசனைகள்.", "footer.gamesHeading": "விளையாட்டுகள்", "footer.companyHeading": "நிறுவனம்", "footer.aboutUs": "எங்களைப் பற்றி", "footer.copyright": "&copy; 2026 GY Industries. அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை.", "footer.builtBy": "கிரிஷ் பிஞ்சா மற்றும் யவ்யா பிஞ்சாவால் உருவாக்கப்பட்டது", "help.title": "உதவி & அடிக்கடி கேட்கப்படும் கேள்விகள்", "help.subtitle": "GY Industries பற்றிய விரைவான பதில்கள்.", "help.faq1.q": "GY Industries என்றால் என்ன?", "help.faq1.a": "இரண்டு சகோதரர்களால் நடத்தப்படும் சிமுலேஷன்கள் மற்றும் விளையாட்டுகளை உருவாக்கும் ஒரு சிறிய ஸ்டூடியோ.", "help.faq2.q": "நீங்கள் என்ன விளையாட்டுகளை உருவாக்குகிறீர்கள்?", "help.faq3.q": "குழுவை எப்படி தொடர்பு கொள்வது?", "help.faq3.a": "எங்கள் மின்னஞ்சல்களுக்கு Contact Us பக்கத்திற்குச் செல்லுங்கள்.", "login.title": "உள்நுழைக", "login.subtitle": "உங்கள் ஸ்கோர்களையும் விருப்பமான விளையாட்டுகளையும் சேமிக்கவும்.", "login.emailLabel": "மின்னஞ்சல்", "login.passwordLabel": "கடவுச்சொல்", "login.note": "கணக்குகள் விரைவில் வருகின்றன — பின்னர் பாருங்கள்!", "ticker.1": "எப்போதும் எங்களால் உருவாக்கப்பட்டது", "ticker.2": "பிரவுசர் அடிப்படையிலானது, உடனடியாக விளையாடக்கூடியது", "ticker.3": "புதிய பயன்முறைகள் தொடர்ந்து சேர்க்கப்படுகின்றன", "ticker.4": "பதிவிறக்கம் இல்லை, ஷார்ட்கட் இல்லை", "about.closingCredit": "GY Industries &middot; கிரிஷ் பிஞ்சா & யவ்யா பிஞ்சாவால் நிறுவப்பட்டது &middot; அக்டோபர் 2025", "about.closingHeadline": "நாங்கள் எப்போதும் இருக்க வேண்டும் என விரும்பிய விளையாட்டுகளை உருவாக்குகிறோம்.", "a1.eyebrow": "இரண்டு சகோதரர்களால் உருவாக்கப்பட்டது, கற்பனையால் இயக்கப்பட்டது", "a1.p1": "வளர்ந்து வரும்போது, நாங்கள் எப்போதும் விளையாட்டுகளால் ஈர்க்கப்பட்டோம் — அவற்றை விளையாடுவது மட்டுமல்ல, அவை எப்படி வேலை செய்கின்றன என்பதைப் பற்றி சிந்திப்பதும். புதிய மெக்கானிக்குகள், வேறுபட்ட உலகங்கள், சிறந்த சவால்கள், சுவாரஸ்யமான கதாபாத்திரங்கள், முற்றிலும் புதிய அனுபவங்களை நாங்கள் கற்பனை செய்தோம். நாங்கள் அடிக்கடி ஒரே கேள்வியை கேட்டுக்கொண்டோம்:", "a1.pull": "&ldquo;யாராவது இது போன்ற ஒரு விளையாட்டை உருவாக்கினால் என்ன?&rdquo;", "a1.p2": "இறுதியில், வேறு யாராவது அந்த விளையாட்டுகளை உருவாக்குவதற்காக காத்திருப்பதற்குப் பதிலாக, நாங்களே அவற்றை உருவாக்க முடிவு செய்தோம். அந்த யோசனை GY Industries ஆனது.", "a1.p3": "GY Industries எங்களுக்கு வெறும் ஒரு விளையாட்டு நிறுவனம் மட்டுமல்ல. எங்கள் மனதிலுள்ள யோசனைகளை உண்மையான அனுபவங்களாக மாற்றும் எங்கள் லட்சியத்தை இது பிரதிபலிக்கிறது. ஒவ்வொரு விளையாட்டும் ஒரு யோசனையுடன் தொடங்குகிறது — சில நேரங்களில் ஒரு கதாபாத்திரம், சில நேரங்களில் ஒரு மெக்கானிக், ஒரு கதை, ஒரு உலகம், அல்லது எங்களுக்கிடையேயான ஒரு சாதாரண உரையாடல். அங்கிருந்து, நாங்கள் சோதனை செய்கிறோம், வடிவமைக்கிறோம், உருவாக்குகிறோம், சோதிக்கிறோம், மாற்றுகிறோம், உடைக்கிறோம், மீண்டும் உருவாக்குகிறோம், யோசனை உண்மையாக மாறும் வரை தொடர்ந்து மேம்படுத்துகிறோம்.", "a1.p4": "சகோதரர்களாக, நாங்கள் எப்போதும் ஒரே மாதிரி சிந்திப்பதில்லை — அதுவே எங்கள் மிகப்பெரிய பலம். எங்களில் ஒருவர் ஒரு விஷயம் எப்படி உணரப்பட வேண்டும் என்பதில் கவனம் செலுத்துகிறார், மற்றவர் அது எப்படி வேலை செய்ய வேண்டும் என்பதை சிந்திக்கிறார். வெவ்வேறு யோசனைகள், தொடர்ச்சியான விவாதங்கள், சோதனை, பகிரப்பட்ட லட்சியம் ஆகியவற்றின் இந்த கலவை GY Industries இன் மையத்தில் உள்ளது.", "a2.eyebrow": "நாங்களே விளையாட விரும்பும் விளையாட்டுகள்", "a2.pull": "நாங்களே அதை விளையாட ஆர்வமாக இல்லை என்றால், வேறு யாரும் ஆர்வமாக இருப்பார்கள் என்று எதிர்பார்க்கக் கூடாது.", "a2.p1": "நினைவில் நிற்கும் விளையாட்டுகளை உருவாக்க விரும்புகிறோம். இன்னும் ஒரு சுற்று விளையாட வேண்டும் என்ற ஆசையை ஏற்படுத்தும் விளையாட்டுகள். அடுத்து என்ன நடக்கும் என்ற ஆர்வத்தை ஏற்படுத்தும் விளையாட்டுகள். நண்பர்களுடன் பேசக்கூடிய விளையாட்டுகள். நூற்றுக்கணக்கான முறை அனுபவிக்காத யோசனைகளை அறிமுகப்படுத்தும் விளையாட்டுகள்.", "a2.p2": "வெறும் ட்ரெண்டைப் பின்பற்றுவதற்காக எதையும் உருவாக்குவதில் எங்களுக்கு ஆர்வம் இல்லை. ஒவ்வொரு GY Industries திட்டமும் அதன் சொந்த அடையாளம், ஆளுமை, இருப்பதற்கான காரணம் கொண்டிருக்க வேண்டும் என்று விரும்புகிறோம். ஒவ்வொரு யோசனையும் மிகப்பெரியதாக இருக்க வேண்டும் என்று இதன் அர்த்தமல்ல — சில நேரங்களில் எளிமையான கருத்துக்கள் மிகவும் மகிழ்ச்சியான அனுபவங்களை உருவாக்குகின்றன. விளையாட்டு வேடிக்கையாகவும், படைப்பாற்றலுடனும், மெருகூட்டப்பட்டும், ஒருவரின் நேரத்திற்கு தகுதியானதாகவும் இருக்கிறதா என்பதே முக்கியம்.", "a3.eyebrow": "தன் கதையின் தொடக்கத்தில் இருக்கும் ஒரு நிறுவனம்", "a3.p1": "GY Industries அக்டோபர் 2025 இல் நிறுவப்பட்டது, அதாவது எங்கள் கதை இப்போது தான் தொடங்குகிறது. சிறந்த விளையாட்டுகளை உருவாக்க நேரம் தேவை என்பதை நாங்கள் அறிவோம் — படைப்பாற்றல், தொழில்நுட்ப திறமை, பொறுமை, சோதனை, கருத்துக்கள், தொடர்ந்து கற்றுக்கொள்ளும் விருப்பம்.", "a3.p2": "ஒவ்வொரு யோசனையும் முதல் முறையிலேயே சரியாக வேலை செய்யும் என்று நாங்கள் எதிர்பார்க்கவில்லை. உண்மையில், நாங்கள் அதற்கு நேர்மாறாகவே எதிர்பார்க்கிறோம். சோதனையின் மூலம் தான் சிறந்த சில யோசனைகள் கண்டறியப்படுகின்றன என்று நம்புகிறோம். வளர்ச்சியின் போது ஒரு மெக்கானிக் முற்றிலும் மாறலாம். ஒரு சிறிய அம்சம் ஒரு விளையாட்டின் மிக முக்கியமான பகுதியாக மாறலாம். சுவாரஸ்யமாக இருக்கும் என்று நினைத்த ஒன்று வேலை செய்யாமல் போகலாம் — தற்செயலாக உருவான ஒன்று அற்புதமாக மாறலாம். இது விளையாட்டுகளை உருவாக்குவதன் ஒரு பகுதி, அதே நேரம் அதை சுவாரஸ்யமாக்கும் ஒன்றும் தான்.", "a4.mission.eyebrow": "எங்கள் நோக்கம்", "a4.mission.p1": "விளையாட்டு வீரர்கள் உண்மையிலேயே ரசிக்கும் அசல், மகிழ்ச்சியான, நினைவில் நிற்கும் விளையாட்டுகளை உருவாக்குவது — படைப்பாற்றலையும் தொழில்நுட்பத்தையும் இணைத்து தொடங்குவதற்கு எளிதான ஆனால் மறக்க முடியாத அனுபவங்களை உருவாக்குவது.", "a4.mission.p2": "GY Industries வளரும்போது, புதிய யோசனைகள், வகைகள், மெக்கானிக்குகள், தொழில்நுட்பங்கள், விளையாட்டுகள் மூலம் கதை சொல்லும் புதிய வழிகளை தொடர்ந்து ஆராய திட்டமிட்டுள்ளோம். நாங்கள் உருவாக்கும் அனைத்தையும் இணைப்பது:", "a4.mission.pull": "விளையாடுவதற்கு தகுதியான ஒன்றை உருவாக்குவது.", "a4.vision.eyebrow": "எங்கள் தொலைநோக்கு", "a4.vision.p1": "இரண்டு சகோதரர்களால் தொடங்கப்பட்ட ஒரு சிறிய நிறுவனத்திலிருந்து, படைப்பாற்றல், அசல்தன்மை, லட்சியமிக்க யோசனைகளுக்காக அங்கீகரிக்கப்படும் ஒரு விளையாட்டு ஸ்டூடியோவாக GY Industries வளர வேண்டும் என்று விரும்புகிறோம்.", "a4.vision.p2": "நாங்கள் உலகங்களை உருவாக்க விரும்புகிறோம். மக்கள் நினைவில் வைத்திருக்கும் கதாபாத்திரங்களை உருவாக்க விரும்புகிறோம். எங்கள் விளையாட்டுகளைச் சுற்றி சமூகங்களை உருவாக்க விரும்புகிறோம் — நிறுவனத்தைத் தொடங்கிய அந்த மனநிலையை பாதுகாக்க விரும்புகிறோம்: இன்னும் இல்லாத ஒரு விளையாட்டை கற்பனை செய்யும் உற்சாகம், &ldquo;நாம் ஏன் இதை உருவாக்கக்கூடாது?&rdquo; என்று கேட்பது.", "a5.eyebrow": "விளையாட்டு வீரர்களுக்காக உருவாக்கப்பட்டது", "a5.p1": "விளையாட்டு வீரர்கள் தான் இறுதியில் விளையாட்டுகள் இருப்பதற்கான காரணம். அதனால்தான் எங்கள் விளையாட்டுகளை விளையாடும் மக்களின் கருத்துகளைக் கேட்பது, அவற்றை உருவாக்குவது போலவே முக்கியம் என்று நம்புகிறோம். கருத்துகள், பரிந்துரைகள், விமர்சனங்கள், எதிர்பாராத உத்திகள், சமூக படைப்புகள், விளையாட்டு வீரர்கள் கண்டறியும் விசித்திரமான விஷயங்கள் கூட ஒரு விளையாட்டை அதன் அசல் கருத்தை விட சிறப்பான ஒன்றாக மாற்ற உதவும்.", "a5.p2": "எங்கள் விளையாட்டுகளும் சமூகமும் வளரும்போது, விளையாட்டு வீரர்கள் எங்களுடன் இந்த பயணத்தைத் தொடர்வதாக உணர வேண்டும் என்று விரும்புகிறோம் — அடுத்த தயாரிப்புக்காக வெறுமனே காத்திருப்பதற்குப் பதிலாக.", "a6.eyebrow": "எப்போதும் கற்றல், எப்போதும் உருவாக்குதல்", "a6.p1": "நாங்கள் இன்னும் எங்கள் பயணத்தின் ஆரம்பத்தில் இருக்கிறோம், நிறைய சாதிக்க வேண்டியுள்ளது. கற்றுக்கொள்ள வேண்டிய புதிய தொழில்நுட்பங்கள். முயற்சி செய்ய வேண்டிய புதிய யோசனைகள். தீர்க்க வேண்டிய புதிய சவால்கள். உருவாக்க வேண்டிய புதிய விளையாட்டுகள். வழியில் நிறைய பிழைகளும் இருக்கலாம்.", "a6.p2": "ஆனால் அதனால்தான் நாங்கள் தொடங்கினோம். உருவாக்க, சோதனை செய்ய, கற்றுக்கொள்ள, எங்களை உற்சாகப்படுத்தும் யோசனைகளை முயற்சிக்க சுதந்திரம் வேண்டும் என்பதால் GY Industries இருக்கிறது. அக்டோபர் 2025 இல் இரண்டு சகோதரர்களுக்கிடையேயான ஒரு யோசனையாக தொடங்கியது இப்போது மிகப்பெரியதாக மாறி வருகிறது — இது இன்னும் ஆரம்பம் தான்.", "staff.eyebrow": "பணியாளர்களுக்கு மட்டும்", "staff.headline": "திரைக்குப் <em>பின்னால்</em>.", "staff.lead": "இந்தப் பகுதி GY Industries குழுவினருக்கு மட்டுமே.", "staff.enterCode": "பணியாளர் குறியீட்டை உள்ளிடவும்", "staff.passwordPlaceholder": "குறியீடு", "staff.submit": "நுழைக", "staff.wrongPassword": "தவறான குறியீடு. மீண்டும் முயற்சிக்கவும்.", "staff.welcome": "மீண்டும் வரவேற்கிறோம். இந்த டாஷ்போர்டு நிறுவனர்கள் மற்றும் குழுவினருக்கு மட்டுமே.", "staff.rosterHeading": "முழு பட்டியல் & பொறுப்புகள்", "staff.lockAgain": "இந்தப் பக்கத்தை பூட்டு", "staff.navLabel": "பணியாளர்", "admin.stat.games": "செயலில் உள்ள விளையாட்டுகள்", "admin.stat.team": "குழு உறுப்பினர்கள்", "admin.stat.languages": "செயலில் உள்ள மொழிகள்", "admin.stat.status":