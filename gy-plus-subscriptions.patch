gree": "J'accepte les", "auth.terms": "Conditions", "auth.and": "et la", "auth.privacy": "Politique de confidentialité", "auth.usernameFree": "Ce nom d'utilisateur est disponible.", "auth.resend": "Renvoyer l'e-mail de confirmation", "auth.msg.passwordMismatch": "Les mots de passe ne correspondent pas.", "auth.msg.termsNeeded": "Veuillez accepter les Conditions et la Politique de confidentialité.", "auth.msg.emailTaken": "Cet e-mail a déjà un compte. Essayez de vous connecter ou de réinitialiser votre mot de passe.", "auth.msg.rateLimited": "Trop de tentatives. Attendez une minute et réessayez.", "auth.msg.resent": "E-mail de confirmation envoyé. Vérifiez votre boîte de réception.", "auth.msg.passwordWeak": "Ce mot de passe est trop facile à deviner. Essayez-en un plus long ou moins courant."}, "hi": {"brand.tagline": "सिम और गेम्स", "nav.home": "होम", "nav.about": "हमारे बारे में", "nav.contact": "संपर्क करें", "nav.exploreGames": "गेम्स देखें", "home.eyebrow": "<b>दो भाई</b> &middot; स्थापना अक्टूबर 2025", "home.headline": "छोटा स्टूडियो।<br><em>ईमानदार</em> गेम्स।", "home.lead": "GY Industries शुरू से सिम और गेम्स बनाता है — बिना टेम्पलेट, बिना शॉर्टकट के। सब कुछ सीधे आपके ब्राउज़र में खेलने योग्य है।", "home.cta.explore": "गेम्स देखें →", "common.contactUs": "संपर्क करें", "diff.eyebrow": "GY Industries की खासियत", "diff.heading": "उद्देश्य के साथ बना, खेलने के लिए तैयार", "diff.item1.title": "हमेशा हमारे द्वारा बनाया गया", "diff.item1.body": "हर गेम दो भाइयों द्वारा खुद डिज़ाइन और कोड किया जाता है — कोई टेम्पलेट नहीं, कोई शॉर्टकट नहीं, कोई आउटसोर्सिंग नहीं।", "diff.item2.title": "तुरंत खेलने योग्य", "diff.item2.body": "कोई डाउनलोड नहीं, कोई इंस्टॉल नहीं, कोई इंतज़ार नहीं। लिंक पर क्लिक करें और सीधे गेम में पहुँच जाएँ।", "diff.item3.title": "एक छोटा स्टूडियो", "diff.item3.body": "हम खुद हर चीज़ बनाते, टेस्ट करते और लॉन्च करते हैं, शुरू से अंत तक — और यह तो अभी शुरुआत है।", "games.eyebrow": "हमारे गेम्स", "games.heading": "अब तक हमने क्या बनाया है", "games.cat.simulation": "सिमुलेशन", "games.cat.collection": "कलेक्शन", "games.cat.arcade": "आर्केड", "games.cat.strategy": "रणनीति", "cta.heading": "कोई आइडिया है?<br>कोई भी गेम। कोई भी मोड। खेलने के लिए आपका।", "cta.browseGames": "गेम्स देखें", "about.eyebrow": "हमारे बारे में", "about.headline": "दो भाई,<br>एक <em>स्टूडियो</em>।", "about.lead": "GY Industries की कहानी।", "role.founder": "संस्थापक", "role.cofounder": "सह-संस्थापक", "role.cmSales": "चीफ़ मार्केटिंग एंड सेल्स", "role.designer": "डिज़ाइनर", "role.cfo": "चीफ़ फाइनेंस", "role.marketing": "मार्केटिंग", "role.illustrator": "इलस्ट्रेटर", "about.storyPanel": "GY Industries की शुरुआत <em>अक्टूबर 2025</em> में एक सीधे से विचार से हुई: वे गेम्स बनाना जिन्हें हम हमेशा से मौजूद देखना चाहते थे।", "common.estOct2025": "स्थापना अक्टूबर 2025", "team.eyebrow": "टीम", "team.heading": "वे लोग जो इसे संभव बनाते हैं", "contact.headline": "हमें <em>हैलो</em> कहें।", "contact.lead": "सवाल, आइडिया, या बस बलूत के बारे में बात करनी है?", "contact.studioInfo": "स्टूडियो जानकारी", "footer.description": "दो भाइयों, ग्रिश पिंचा और यव्या पिंचा द्वारा बनाए गए सिम और गेम्स। छोटा स्टूडियो, बड़े आइडिया।", "footer.gamesHeading": "गेम्स", "footer.companyHeading": "कंपनी", "footer.aboutUs": "हमारे बारे में", "footer.copyright": "&copy; 2026 GY Industries. सर्वाधिकार सुरक्षित।", "footer.builtBy": "ग्रिश पिंचा और यव्या पिंचा द्वारा बनाया गया", "help.title": "मदद और सामान्य सवाल", "help.subtitle": "GY Industries के बारे में त्वरित जवाब।", "help.faq1.q": "GY Industries क्या है?", "help.faq1.a": "दो भाइयों द्वारा चलाया जाने वाला एक छोटा स्टूडियो जो सिम और गेम्स बनाता है।", "help.faq2.q": "आप कौन-कौन से गेम बनाते हैं?", "help.faq3.q": "टीम से कैसे संपर्क करें?", "help.faq3.a": "हमारे ईमेल के लिए Contact Us पेज पर जाएँ।", "login.title": "लॉग इन करें", "login.subtitle": "अपने स्कोर और पसंदीदा गेम्स सेव करें।", "login.emailLabel": "ईमेल", "login.passwordLabel": "पासवर्ड", "login.note": "अकाउंट जल्द आ रहे हैं — बाद में फिर देखें!", "ticker.1": "हमेशा हमारे द्वारा बनाया गया", "ticker.2": "ब्राउज़र-आधारित, तुरंत खेलने योग्य", "ticker.3": "नए मोड नियमित रूप से जोड़े जाते हैं", "ticker.4": "कोई डाउनलोड नहीं, कोई शॉर्टकट नहीं", "about.closingCredit": "GY Industries &middot; ग्रिश पिंचा और यव्या पिंचा द्वारा स्थापित &middot; अक्टूबर 2025", "about.closingHeadline": "हम वे गेम्स बनाते हैं जिन्हें हम हमेशा से मौजूद देखना चाहते थे।", "a1.eyebrow": "दो भाइयों द्वारा बनाया गया, कल्पना से प्रेरित", "a1.p1": "बड़े होते हुए, हम हमेशा गेम्स से आकर्षित रहे — न सिर्फ उन्हें खेलने से, बल्कि यह सोचने से कि वे कैसे काम करते हैं। हम नई मैकेनिक्स, अलग दुनियाएँ, बेहतर चुनौतियाँ, दिलचस्प किरदार और बिल्कुल नए अनुभवों की कल्पना करते थे। हम अक्सर खुद से एक ही सवाल पूछते थे:", "a1.pull": "&ldquo;अगर कोई ऐसा गेम बनाए तो कैसा हो?&rdquo;", "a1.p2": "आखिरकार हमने तय किया कि किसी और के इंतज़ार करने के बजाय, हम खुद वे गेम्स बनाएँगे। यही आइडिया GY Industries बन गया।", "a1.p3": "हमारे लिए GY Industries सिर्फ एक गेम कंपनी नहीं है। यह हमारी उस महत्वाकांक्षा को दर्शाता है कि हम अपने दिमाग के आइडियाज़ को असली अनुभवों में बदलें। हर गेम एक आइडिया से शुरू होता है — कभी एक किरदार, कभी एक मैकेनिक, एक कहानी, एक दुनिया, या हमारे बीच की एक साधारण बातचीत से। वहाँ से हम प्रयोग करते हैं, डिज़ाइन करते हैं, बनाते हैं, टेस्ट करते हैं, बदलते हैं, तोड़ते हैं, दोबारा बनाते हैं, और तब तक सुधारते रहते हैं जब तक वह आइडिया असली न बन जाए।", "a1.p4": "भाई होने के नाते, हम हमेशा एक जैसा नहीं सोचते — और यही हमारी सबसे बड़ी ताकत है। हम में से एक यह सोचता है कि कोई चीज़ कैसी महसूस होनी चाहिए, जबकि दूसरा सोचता है कि वह कैसे काम करनी चाहिए। अलग-अलग आइडियाज़, लगातार चर्चाओं, प्रयोगों और साझा महत्वाकांक्षा का यही मेल GY Industries के केंद्र में है।", "a2.eyebrow": "वे गेम्स जिन्हें हम खुद खेलना चाहेंगे", "a2.pull": "अगर हमें खुद उसे खेलने में मज़ा न आए, तो हमें किसी और से भी वैसी उम्मीद नहीं रखनी चाहिए।", "a2.p1": "हम यादगार गेम्स बनाना चाहते हैं। ऐसे गेम्स जो एक राउंड और खेलने का मन करें। ऐसे गेम्स जो आगे क्या होगा, इस बारे में उत्सुक बनाएँ। ऐसे गेम्स जिनके बारे में आप दोस्तों से बात कर सकें। ऐसे गेम्स जो ऐसे आइडिया लाएँ जो आपने सैकड़ों बार पहले अनुभव न किए हों।", "a2.p2": "हमें सिर्फ ट्रेंड की वजह से कुछ बनाने में दिलचस्पी नहीं है। हम चाहते हैं कि हर GY Industries प्रोजेक्ट की अपनी पहचान, अपना व्यक्तित्व और अपनी वजह हो। इसका मतलब यह नहीं कि हर आइडिया बहुत बड़ा होना चाहिए — कभी-कभी सबसे सरल कॉन्सेप्ट सबसे मज़ेदार अनुभव बनाते हैं। जो मायने रखता है वह यह है कि गेम मज़ेदार, रचनात्मक, पॉलिश्ड और किसी के समय के लायक हो।", "a3.eyebrow": "अपनी कहानी की शुरुआत में एक कंपनी", "a3.p1": "GY Industries की स्थापना अक्टूबर 2025 में हुई, यानी हमारी कहानी अभी बस शुरू हुई है। हम जानते हैं कि अच्छे गेम्स बनाने में समय लगता है — रचनात्मकता, तकनीकी कौशल, धैर्य, प्रयोग, फीडबैक और लगातार सीखते रहने की इच्छा।", "a3.p2": "हम यह उम्मीद नहीं करते कि हर आइडिया पहली बार में ही पूरी तरह काम करे। असल में, हम इसका उल्टा ही मानते हैं। हमारा मानना है कि कुछ बेहतरीन आइडिया प्रयोग करने से ही मिलते हैं। डेवलपमेंट के दौरान कोई मैकेनिक पूरी तरह बदल सकती है। कोई छोटी सी फीचर गेम का सबसे ज़रूरी हिस्सा बन सकती है। जो चीज़ हमें रोमांचक लगी हो, वह बिल्कुल काम न करे — और लगभग गलती से बनी कोई चीज़ शानदार निकल सकती है। यही गेम बनाने का हिस्सा है, और यही इसे रोमांचक भी बनाता है।", "a4.mission.eyebrow": "हमारा मिशन", "a4.mission.p1": "ऐसे मौलिक, मनोरंजक और यादगार गेम्स बनाना जिन्हें खिलाड़ी सच में पसंद करें — रचनात्मकता और तकनीक को मिलाकर ऐसे अनुभव बनाना जो शुरू करना आसान हो पर भुलाना मुश्किल।", "a4.mission.p2": "जैसे-जैसे GY Industries बढ़ेगा, हम नए आइडिया, शैलियों, मैकेनिक्स, तकनीकों और गेम्स के ज़रिए कहानी कहने के नए तरीकों को खोजते रहेंगे। जो चीज़ हमारी हर रचना को जोड़ती है:", "a4.mission.pull": "कुछ ऐसा बनाना जो खेलने लायक हो।", "a4.vision.eyebrow": "हमारा विज़न", "a4.vision.p1": "हम चाहते हैं कि GY Industries दो भाइयों द्वारा शुरू की गई एक छोटी कंपनी से बढ़कर रचनात्मकता, मौलिकता और महत्वाकांक्षी आइडियाज़ के लिए पहचाने जाने वाला एक गेम स्टूडियो बने।", "a4.vision.p2": "हम दुनियाएँ बनाना चाहते हैं। हम ऐसे किरदार बनाना चाहते हैं जिन्हें लोग याद रखें। हम अपने गेम्स के इर्द-गिर्द कम्युनिटी बनाना चाहते हैं — और उस सोच को बनाए रखना चाहते हैं जिसने कंपनी की शुरुआत की: एक ऐसे गेम की कल्पना करने का रोमांच जो अभी मौजूद नहीं है, और यह पूछना &ldquo;हम इसे क्यों न बनाएँ?&rdquo;", "a5.eyebrow": "खिलाड़ियों के लिए बना", "a5.p1": "गेम्स आखिरकार खिलाड़ियों की वजह से ही मौजूद हैं। इसीलिए हमारा मानना है कि हमारे गेम्स खेलने वाले लोगों की बात सुनना उतना ही ज़रूरी है जितना उन्हें बनाना। फीडबैक, सुझाव, आलोचना, अनपेक्षित रणनीतियाँ, कम्युनिटी की रचनाएँ, और खिलाड़ियों द्वारा खोजी गई अजीब चीज़ें भी किसी गेम को उसके मूल कॉन्सेप्ट से बेहतर बनाने में मदद कर सकती हैं।", "a5.p2": "जैसे-जैसे हमारे गेम्स और कम्युनिटी बढ़ते हैं, हम चाहते हैं कि खिलाड़ी महसूस करें कि वे हमारे साथ इस सफ़र में शामिल हैं — न कि सिर्फ अगले प्रोडक्ट का इंतज़ार कर रहे हैं।", "a6.eyebrow": "हमेशा सीखना, हमेशा बनाना", "a6.p1": "हम अभी भी अपने सफ़र की शुरुआत में हैं, और बहुत कुछ हासिल करना बाकी है। सीखने के लिए नई तकनीकें। आज़माने के लिए नए आइडिया। सुलझाने के लिए नई चुनौतियाँ। बनाने के लिए नए गेम्स। और शायद रास्ते में ढेर सारी बग्स।", "a6.p2": "लेकिन इसीलिए हमने शुरुआत की थी। GY Industries इसलिए है क्योंकि हम बनाने, प्रयोग करने, सीखने और उन आइडियाज़ को आज़माने की आज़ादी चाहते थे जो हमें उत्साहित करते हैं। जो अक्टूबर 2025 में दो भाइयों के बीच एक आइडिया के रूप में शुरू हुआ, वह अब कहीं बड़ा बनता जा रहा है — और यह तो अभी बस शुरुआत है।", "staff.eyebrow": "केवल स्टाफ के लिए", "staff.headline": "पर्दे के <em>पीछे</em>।", "staff.lead": "यह भाग सिर्फ GY Industries टीम के लिए है।", "staff.enterCode": "स्टाफ पासकोड डालें", "staff.passwordPlaceholder": "पासकोड", "staff.submit": "प्रवेश करें", "staff.wrongPassword": "गलत पासकोड। फिर से कोशिश करें।", "staff.welcome": "वापसी पर स्वागत है। यह डैशबोर्ड सिर्फ संस्थापकों और टीम के लिए है।", "staff.rosterHeading": "पूरी सूची और भूमिकाएँ", "staff.lockAgain": "इस पेज को लॉक करें", "staff.navLabel": "स्टाफ", "admin.stat.games": "लाइव गेम्स", "admin.stat.team": "टीम सदस्य", "admin.stat.languages": "सक्रिय भाषाएँ", "admin.stat.status": "साइट स्थिति: लाइव", "admin.games.heading": "गेम्स", "