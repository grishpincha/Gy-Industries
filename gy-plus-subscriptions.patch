diff --git a/api/_lib.js b/api/_lib.js
new file mode 100644
index 0000000..8861196
--- /dev/null
+++ b/api/_lib.js
@@ -0,0 +1,21 @@
+// Shared helpers for the subscription API routes (Vercel Node functions).
+const Stripe = require('stripe');
+const { createClient } = require('@supabase/supabase-js');
+
+const stripe = new Stripe(process.env.STRIPE_SECRET_KEY);
+// Service-role client: bypasses RLS. Server-side only, never ship this key to the browser.
+const admin = createClient(process.env.SUPABASE_URL, process.env.SUPABASE_SERVICE_ROLE_KEY, {
+  auth: { persistSession: false }
+});
+const SITE = (process.env.SITE_URL || 'https://gyindustries.vercel.app').replace(/\/$/, '');
+
+// Verifies the Supabase access token sent by the browser and returns the user (or null).
+async function userFromRequest(req) {
+  const h = req.headers.authorization || '';
+  const token = h.startsWith('Bearer ') ? h.slice(7) : null;
+  if (!token) return null;
+  const { data, error } = await admin.auth.getUser(token);
+  return error || !data || !data.user ? null : data.user;
+}
+
+module.exports = { stripe, admin, SITE, userFromRequest };
diff --git a/api/create-checkout-session.js b/api/create-checkout-session.js
new file mode 100644
index 0000000..4a6d0db
--- /dev/null
+++ b/api/create-checkout-session.js
@@ -0,0 +1,38 @@
+const { stripe, admin, SITE, userFromRequest } = require('./_lib');
+
+module.exports = async (req, res) => {
+  if (req.method !== 'POST') return res.status(405).json({ error: 'POST only' });
+  try {
+    const user = await userFromRequest(req);
+    if (!user) return res.status(401).json({ error: 'Log in first.' });
+
+    const { data: row } = await admin
+      .from('subscriptions')
+      .select('stripe_customer_id,status')
+      .eq('user_id', user.id)
+      .maybeSingle();
+
+    // Don't let someone pay twice: send them to the portal instead.
+    if (row && ['active', 'trialing', 'past_due'].includes(row.status)) {
+      return res.status(409).json({ error: 'already_subscribed' });
+    }
+
+    const session = await stripe.checkout.sessions.create({
+      mode: 'subscription',
+      line_items: [{ price: process.env.STRIPE_PRICE_ID, quantity: 1 }],
+      client_reference_id: user.id,
+      ...(row && row.stripe_customer_id
+        ? { customer: row.stripe_customer_id }
+        : { customer_email: user.email }),
+      // The webhook reads this to know which GY account the subscription belongs to.
+      subscription_data: { metadata: { user_id: user.id } },
+      allow_promotion_codes: true,
+      success_url: SITE + '/?sub=success',
+      cancel_url: SITE + '/?sub=cancelled'
+    });
+    return res.status(200).json({ url: session.url });
+  } catch (e) {
+    console.error('checkout error', e);
+    return res.status(500).json({ error: 'Could not start checkout.' });
+  }
+};
